# Optional provider keys. Browser Settings can supply or override either key.
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Existing OpenAI Secure MCP Tunnel ID. Used by npm run tunnel; never exposed by the web API.
OPENAI_TUNNEL_ID=

# Optional restricted tunnel runtime key. Blank reuses OPENAI_API_KEY.
CONTROL_PLANE_API_KEY=

# Optional tunnel executable. Blank prefers data/bin/tunnel-client, then tunnel-client on PATH.
# npm run tunnel:install installs the current official platform-specific client under data/bin/.
TUNNEL_CLIENT_BIN=

# Optional custom llama.cpp base URL, including /v1.
# Blank uses the app's built-in endpoint. A browser Settings URL overrides this.
CUSTOM_BASE_URL=

# Web server listening address. Use 0.0.0.0 to listen on all IPv4 interfaces.
HOST=127.0.0.1

# Web server port. Blank defaults to 4379 and allows a free-port fallback if busy.
# Setting an explicit port disables that fallback. Use 0 for an unused port.
PORT=4379

# Optional browser-reachable origin for workspace links, e.g. your Tailscale Serve HTTPS origin.
# Blank uses the local server address. Secure MCP Tunnel does not expose the frontend.
FRONTEND_BASE_URL=

# Storage budget in bytes (1 GiB). 0 disables the size limit.
WORKSPACE_MAX_BYTES=1073741824

# Saved workspaces are always protected from cleanup. true excludes their bytes from the budget.
WORKSPACE_EXCLUDE_SAVED_FROM_LIMIT=true

# Remove unsaved workspaces after this many inactive days. 0 disables age expiry.
WORKSPACE_TTL_DAYS=30

# Restart the server after editing .env. Existing shell variables take precedence.
