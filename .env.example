# Optional provider keys. Browser Settings can supply or override either key.
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Optional custom llama.cpp base URL, including /v1.
# Blank uses the app's built-in endpoint. A browser Settings URL overrides this.
CUSTOM_BASE_URL=

# Web server listening address. Use 0.0.0.0 to listen on all IPv4 interfaces.
HOST=127.0.0.1

# Web server port. Blank defaults to 4379 and allows a free-port fallback if busy.
# Setting an explicit port disables that fallback. Use 0 for an unused port.
PORT=4379

# Restart the server after editing .env. Existing shell variables take precedence.
